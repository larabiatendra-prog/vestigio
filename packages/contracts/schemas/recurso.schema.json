{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vestigio.local/schemas/recurso.schema.json",
  "title": "Recurso del catalogo",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "titulo", "idioma", "formato", "derechos", "modulos", "assets"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "titulo": { "type": "string", "minLength": 1 },
    "idioma": { "type": "string", "minLength": 2 },
    "formato": {
      "enum": ["pdf", "epub", "html", "markdown", "txt", "zim", "imagen", "audio"]
    },
    "derechos": {
      "enum": ["open-redistributable", "personal-preservation", "unknown-blocked"]
    },
    "modulos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(M(0[1-9]|1[0-2])|MV)$" }
    },
    "autor": { "type": "string" },
    "fechaPublicacion": { "type": "string" },
    "resumen": { "type": "string" },
    "etiquetas": { "type": "array", "items": { "type": "string" } },
    "geografia": { "type": "array", "items": { "type": "string" } },
    "ejes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "autoridad": {
          "enum": ["desconocida", "comunitaria", "profesional", "academica", "organismo"]
        },
        "vigencia": { "enum": ["actual", "necesita-revision", "historica-util", "desconocida"] },
        "consenso": {
          "enum": ["no-aplica", "discutido", "emergente", "mixto", "amplio", "establecido"]
        },
        "trazabilidad": { "enum": ["insuficiente", "parcial", "completa"] },
        "dificultad": { "enum": ["sin-previos", "basica", "tecnica", "especialista"] },
        "riesgo": { "enum": ["bajo", "moderado", "alto", "critico"] }
      }
    },
    "origen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adquirido", "sha256"],
      "properties": {
        "url": { "type": "string" },
        "adquirido": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "advertencias": { "type": "array", "items": { "type": "string" } },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "roles", "formato", "rutaLogica", "bytes", "sha256"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "source_original",
              "preservation_master",
              "access_derivative",
              "text_derivative",
              "thumbnail"
            ]
          }
        },
        "formato": {
          "enum": ["pdf", "epub", "html", "markdown", "txt", "zim", "imagen", "audio"]
        },
        "rutaLogica": { "type": "string", "pattern": "^[^:\\\\]+$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "derivadoDe": { "type": "string", "format": "uuid" }
      }
    }
  }
}
